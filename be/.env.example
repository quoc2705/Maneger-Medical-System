DJANGO_SECRET_KEY=change-this-secret-key

DJANGO_DEBUG=False

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://your-domain.com

DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://your-domain.com



# URL gốc HTTPS (production) — dùng tự ghép Return/IPN VNPay nếu không khai riêng

SITE_URL=https://your-domain.com



DB_ENGINE=django.db.backends.mysql

DB_NAME=phongkham

DB_USER=root

DB_PASSWORD=

DB_HOST=127.0.0.1

DB_PORT=3306



# --- VNPAY sandbox (email đăng ký merchant) ---

# TMN + Secret lấy từ email VNPay, không hiện trên cổng TerminalEdit

VNPAY_TMN_CODE=your_tmn_code

VNPAY_HASH_SECRET=your_hash_secret

VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Dùng ngrok khi test local — thay your-ngrok-subdomain bằng URL ngrok hiện tại

VNPAY_RETURN_URL=https://your-ngrok-subdomain.ngrok-free.dev/payment/vnpay-return

VNPAY_IPN_URL=https://your-ngrok-subdomain.ngrok-free.dev/api/don-hang/vnpay-ipn/



# --- Email xác nhận thanh toán (gửi sau IPN VNPay thành công) ---

EMAIL_ENABLED=true

EMAIL_HOST=smtp.gmail.com

EMAIL_PORT=587

EMAIL_USE_TLS=true

EMAIL_HOST_USER=your@gmail.com

EMAIL_HOST_PASSWORD=your_app_password

DEFAULT_FROM_EMAIL=your@gmail.com

CLINIC_NAME=He thong phongkham



# --- SMS (tùy chọn) ---

SMS_ENABLED=false

SMS_API_KEY=your_api_key

SMS_SECRET_KEY=your_secret_key

SMS_BRAND_NAME=PhongKham

